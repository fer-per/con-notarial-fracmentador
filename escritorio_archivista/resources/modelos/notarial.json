{
  "id": "notarial",
  "nombre": "Fragmentador notarial",
  "descripcion": "Catálogo notarial con hoja 'Hoja 1', metadatos en las filas 4 a 9 y jerarquía de 12 niveles con tomo.",
  "hereda_de": "base",
  "excel": {
    "hoja": "Hoja 1",
    "campos_fuertes": ["folios", "escritura", "fecha_inicio", "titulo", "interesado1"],
    "ignorar_si_sin_fuertes": true,
    "ignorar_regex": ["^(protocolo\\s*)?n[°º]?\\s*\\d+$"],
    "detectar_keywords": ["notario", "n° de tomo", "n° de escritura", "tipo de escritura"],
    "detectar_min_matches": 2
  },
  "metadatos": {
    "acervo": {
      "fila": 4,
      "columna": 1,
      "regex": "N[°º]?\\s*(\\d+)",
      "grupo": 1,
      "transformacion": "numero"
    },
    "fondo": {
      "fila": 5,
      "columna": 1,
      "transformacion": "texto"
    },
    "entidad": {
      "fila": 6,
      "columna": 1,
      "transformacion": "texto"
    },
    "seccion": {
      "fila": 7,
      "columna": 1,
      "transformacion": "texto"
    },
    "serie": {
      "fila": 8,
      "columna": 1,
      "transformacion": "texto"
    },
    "escribano": {
      "fila": 9,
      "columna": 1,
      "transformacion": "texto"
    }
  },
  "columnas": {
    "titulo": {
      "aliases": ["tipo de escritura"]
    },
    "protocolo": {
      "aliases": ["n° de prot", "protocolo", "prot"]
    },
    "tomo": {
      "aliases": ["n° de tomo", "tomo"]
    },
    "escritura": {
      "aliases": ["n° de escritura", "nro de escritura", "numero de escritura"]
    },
    "alcance": {
      "aliases": ["alcance y contenido", "alcance"]
    },
    "estado_conservacion": {
      "aliases": ["estado de conservacion", "estado conservacion"]
    },
    "fecha_descripcion": {
      "aliases": ["fecha de la descripcion", "fecha descripcion"]
    }
  },
  "jerarquia": {
    "niveles": [
      {
        "tipo": "acervo",
        "plantilla": "ACERVO DOCUMENTAL NUMERO {valor}",
        "respaldo": "ACERVO DOCUMENTAL",
        "mayusculas": true
      },
      {
        "tipo": "siglo",
        "plantilla": "SIGLO {valor}",
        "respaldo": "SIN SIGLO",
        "mayusculas": true
      },
      {
        "tipo": "constante",
        "valor": "FONDO DOCUMENTAL"
      },
      {
        "tipo": "escribano",
        "respaldo": "SIN ESCRIBANO",
        "mayusculas": true
      },
      {
        "tipo": "anio",
        "respaldo": "SIN AÑO"
      },
      {
        "tipo": "protocolo",
        "plantilla": "PROTOCOLO {valor}",
        "respaldo": "SIN PROTOCOLO",
        "mayusculas": true
      },
      {
        "tipo": "tomo",
        "plantilla": "TOMO {valor}",
        "respaldo": "SIN TOMO",
        "mayusculas": true
      },
      {
        "tipo": "escritura",
        "plantilla": "REGISTRO {valor}",
        "respaldo": "SIN REGISTRO",
        "mayusculas": true
      },
      {
        "tipo": "titulo",
        "respaldo": "SIN TITULO DE ESCRITURA",
        "mayusculas": true
      },
      {
        "tipo": "mes",
        "respaldo": "SIN MES"
      },
      {
        "tipo": "interesado1",
        "respaldo": "DATOS DE LOS INTERESADOS ILEGIBLES"
      },
      {
        "tipo": "archivo",
        "respaldo": "DATOS DE LOS INTERESADOS ILEGIBLES.pdf"
      }
    ]
  }
}
